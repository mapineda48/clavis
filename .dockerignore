# Minimal build context: speeds up the upload to the daemon and avoids leaking secrets.
#
# IMPORTANT: this file must NOT exclude pnpm-lock.yaml, pnpm-workspace.yaml,
# tsconfig.base.json, package.json or packages/. The API Dockerfile needs them to
# install with --frozen-lockfile and to build the workspace.

# --- dependencies and artefacts: generated inside the image
**/node_modules
**/dist
**/build
**/coverage
**/*.tsbuildinfo
**/.vite
.pnpm-store

# --- version control
.git
.gitignore

# --- environment: variables arrive through docker compose, not baked into the image
.env
.env.*

# --- noise
**/*.log
docs
.vscode
.idea
**/.DS_Store
