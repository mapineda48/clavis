# Shared code style for any editor. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: two trailing spaces mean a line break, so they must not be trimmed.
[*.md]
trim_trailing_whitespace = false

# Make requires real tabs at the start of every recipe line.
[Makefile]
indent_style = tab

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{sh,mjs,js,ts,tsx,css,html,sql}]
indent_size = 2
