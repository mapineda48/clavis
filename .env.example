# =============================================================================
# Plantilla de variables de entorno del monorepo.
#
#   cp .env.example .env
#
# Este UNICO archivo .env de la raiz lo consumen:
#   - docker compose (todos los servicios y las variables derivadas)
#   - Vite (vite.config.ts fija envDir a la raiz, por eso las VITE_* viven aqui)
#
# .env esta ignorado por git: los valores reales no se versionan nunca.
# Los valores de abajo son de DESARROLLO LOCAL; no los uses en un entorno real.
# =============================================================================

# --- proyecto
# Prefijo de contenedores, redes y volumenes que crea docker compose.
COMPOSE_PROJECT_NAME=erp-demo

# --- postgres
# La base de la aplicacion y la de Keycloak conviven en la misma instancia.
# infra/postgres/00-init-databases.sh crea el rol y la base de Keycloak al arrancar.
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password

# --- keycloak
# KC_BOOTSTRAP_ADMIN_* es el administrador de la consola (http://localhost:8080).
# KEYCLOAK_PUBLIC_URL es la URL que ve el navegador: de ella sale el "iss" de los tokens.
# APP_DEV_URL / APP_PROD_URL alimentan los redirect URIs del cliente y el CORS de la API.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_REALM=erp
KEYCLOAK_APP_CLIENT_ID=erp-app
KEYCLOAK_API_CLIENT_ID=erp-api
KEYCLOAK_API_CLIENT_SECRET=erp_api_dev_secret
KEYCLOAK_PUBLIC_URL=http://localhost:8080
APP_DEV_URL=http://localhost:5173
APP_PROD_URL=http://localhost:8081

# --- usuarios demo del realm
# Se crean al importar el realm. admin -> erp-admin, manager -> erp-manager, worker -> erp-user.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@erp.local
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_MANAGER_USERNAME=manager
DEMO_MANAGER_EMAIL=manager@erp.local
DEMO_MANAGER_PASSWORD=Manager123!
DEMO_USER_USERNAME=worker
DEMO_USER_EMAIL=worker@erp.local
DEMO_USER_PASSWORD=Worker123!

# --- api
# CACHE_TTL_SECONDS es el TTL de las listas cacheadas en Valkey.
# MAX_UPLOAD_BYTES limita el tamano de los adjuntos (10 MiB).
API_PORT=3000
LOG_LEVEL=info
CACHE_TTL_SECONDS=60
MAX_UPLOAD_BYTES=10485760

# --- azurite (clave publica de desarrollo de Azurite, no es un secreto)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
AZURE_STORAGE_CONTAINER=erp-attachments

# --- resend (SECRETO: se deja vacio en .env.example)
# Rellena RESEND_API_KEY solo en tu .env local. Para generarla:
#   npm i -g resend           # o: npx resend
#   resend login              # abre el navegador y autoriza tu cuenta
#   resend api-keys create --name erp-demo --permission sending_access
# Copia aqui la clave que imprime (empieza por "re_"). Si la dejas vacia, la API arranca
# igualmente en modo dry-run: registra el correo en el log y no lo envia.
RESEND_API_KEY=
MAIL_FROM=ERP Demo <onboarding@resend.dev>
MAIL_REPLY_TO=
MAIL_ENABLED=true

# --- frontend (Vite lee este mismo .env)
# Solo las variables con prefijo VITE_ llegan al bundle del navegador.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=erp
VITE_KEYCLOAK_CLIENT_ID=erp-app
# Cliente que agrupa los permisos; la SPA los lee de resource_access[<este id>].roles.
# Debe coincidir siempre con KEYCLOAK_API_CLIENT_ID.
VITE_KEYCLOAK_API_CLIENT_ID=erp-api
VITE_API_URL=http://localhost:3000
