# =============================================================================
# Environment variable template for the monorepo.
#
#   cp .env.example .env
#
# This SINGLE .env at the repo root is consumed by:
#   - docker compose (every service plus the derived variables)
#   - Vite (vite.config.ts points envDir at the root, which is why VITE_* lives here)
#
# .env is git-ignored: real values are never committed.
# The values below are for LOCAL DEVELOPMENT; do not use them anywhere real.
# =============================================================================

# --- project
# Prefix docker compose puts on the containers, networks and volumes it creates.
COMPOSE_PROJECT_NAME=clavis

# --- postgres
# The application database and Keycloak's live in the same instance.
# infra/postgres/00-init-databases.sh creates Keycloak's role and database on first boot.
POSTGRES_USER=clavis
POSTGRES_PASSWORD=clavis_dev_password
POSTGRES_DB=clavis
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password

# --- keycloak
# KC_BOOTSTRAP_ADMIN_* is the console administrator (http://localhost:8080).
# KEYCLOAK_PUBLIC_URL is the URL the browser sees: the token "iss" is derived from it.
# APP_DEV_URL / APP_PROD_URL feed the client redirect URIs and the API's CORS list.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_REALM=clavis
KEYCLOAK_APP_CLIENT_ID=clavis-app
KEYCLOAK_API_CLIENT_ID=clavis-api
KEYCLOAK_API_CLIENT_SECRET=clavis_api_dev_secret
KEYCLOAK_PUBLIC_URL=http://localhost:8080
APP_DEV_URL=http://localhost:5173
APP_PROD_URL=http://localhost:8081
# Login screen theme of the realm (the realm's "loginTheme" field).
# `clavis` is the custom theme in infra/keycloak/themes/clavis, mounted into the
# container as /opt/keycloak/themes. Set `keycloak` to go back to the theme the
# server ships with (handy for comparing, or while debugging the custom one);
# `keycloak.v2` is the other built-in theme. Empty is NOT valid: render-realm.mjs
# fails if a marker is left unresolved.
# Careful: the realm only reads this value when it is IMPORTED. To apply it to a
# realm that already exists, see docs/operations.md, section "Login theme".
KEYCLOAK_LOGIN_THEME=clavis
# Theme for the emails Keycloak sends (password reset, email verification...).
KEYCLOAK_EMAIL_THEME=clavis

# --- realm SMTP (used by KEYCLOAK, not by the API)
# The API sends email through the Resend HTTP API; Keycloak only speaks SMTP, so it
# points at the Resend SMTP relay. The password is NOT set here: docker-compose
# reuses RESEND_API_KEY, so there is only one secret to keep.
# If you do not care about the email flow, leave this as it is: the stack boots
# fine and only the "I forgot my password" delivery fails.
KEYCLOAK_SMTP_HOST=smtp.resend.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_USER=resend
# Must be an address on a domain verified in Resend.
KEYCLOAK_SMTP_FROM=onboarding@resend.dev
KEYCLOAK_SMTP_FROM_DISPLAY_NAME="Clavis"

# --- root user
# IMPORTANT: to exercise "I forgot my password" ROOT_EMAIL must be a REAL
# address you can read; root@clavis.local receives nothing.
# The only account the API seeds at boot: it is created (or re-linked) in
# Keycloak and marked is_root in the database. Root bypasses every permission
# check and cannot be edited through the access UI. Every other user is created
# from the application itself.
ROOT_USERNAME=root
ROOT_EMAIL=root@clavis.local
ROOT_PASSWORD=Root123!
ROOT_DISPLAY_NAME=Root

# --- api
# CACHE_TTL_SECONDS is the TTL of the listings cached in Valkey.
# MAX_UPLOAD_BYTES caps the attachment size (10 MiB).
# The two DB_* timeouts apply to every connection of the application pool (not
# to the migrator's, which runs DDL). 0 disables them, as it does in PostgreSQL.
API_PORT=3000
LOG_LEVEL=info
CACHE_TTL_SECONDS=60
MAX_UPLOAD_BYTES=10485760
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# --- azurite (Azurite's public development key, not a secret)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
AZURE_STORAGE_CONTAINER=clavis-attachments

# --- resend (SECRET: left empty in .env.example)
# Fill RESEND_API_KEY in your local .env only. To generate one:
#   npm i -g resend           # or: npx resend
#   resend login              # opens the browser and authorises your account
#   resend api-keys create --name clavis --permission sending_access
# Paste the printed key here (it starts with "re_"). If you leave it empty the API
# still boots in dry-run mode: it logs the email instead of sending it.
RESEND_API_KEY=
MAIL_FROM="Clavis <onboarding@resend.dev>"
MAIL_REPLY_TO=
MAIL_ENABLED=true

# --- frontend (Vite reads this very same .env)
# Only VITE_-prefixed variables make it into the browser bundle.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=clavis
VITE_KEYCLOAK_CLIENT_ID=clavis-app
VITE_API_URL=http://localhost:3000
