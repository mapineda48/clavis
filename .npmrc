# Aborta si la version de Node/pnpm no cumple el campo "engines" del package.json raiz.
# Evita instalar el proyecto con un runtime distinto al que usan las imagenes Docker.
engine-strict=true

# Instala automaticamente las peer dependencies declaradas por los paquetes,
# asi no hay que repetirlas a mano en cada package.json.
auto-install-peers=true

# Los conflictos de peers solo avisan, no rompen la instalacion: el ecosistema de React 19
# todavia arrastra librerias con rangos de peers desactualizados.
strict-peer-dependencies=false

# Usa el lockfile tal cual mientras siga sincronizado con los package.json.
# Instalaciones reproducibles en local y dentro de los builds de Docker.
prefer-frozen-lockfile=true
