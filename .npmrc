# Abort if the Node/pnpm version does not satisfy the "engines" field of the root package.json.
# Keeps the project from being installed with a runtime other than the one the Docker images use.
engine-strict=true

# Install the peer dependencies declared by packages automatically,
# so they do not have to be repeated by hand in every package.json.
auto-install-peers=true

# Peer conflicts only warn, they do not break the install: the React 19 ecosystem
# still drags along libraries with stale peer ranges.
strict-peer-dependencies=false

# Use the lockfile as-is while it stays in sync with the package.json files.
# Reproducible installs both locally and inside the Docker builds.
prefer-frozen-lockfile=true
