[Unit]
Description=Back up the ACME stores as soon as Traefik rewrites one

[Path]
# One entry per resolver store. A directory path would not do: systemd watches
# the directory ENTRY, so it fires when a file appears or disappears but not
# when Traefik rewrites the contents of one that already exists — which is
# exactly what a renewal does.
PathChanged=/var/lib/traefik/production.json
PathChanged=/var/lib/traefik/staging.json
Unit=erp-acme-backup.service

[Install]
WantedBy=multi-user.target
