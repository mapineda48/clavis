[Unit]
Description=Restore the Traefik ACME state from Azure Blob Storage
Requires=erp-blobfuse2.service
After=erp-blobfuse2.service
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Anything this unit creates is private by default. acme.json holds the ACME
# account key and every certificate private key in cleartext.
UMask=0077
ExecStart=/opt/erp/bin/acme-restore.sh

[Install]
WantedBy=multi-user.target
