[Unit]
Description=Block containers from reaching the DigitalOcean metadata service
# DOCKER-USER does not exist until dockerd has created it.
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/erp/bin/metadata-guard.sh

[Install]
WantedBy=multi-user.target
