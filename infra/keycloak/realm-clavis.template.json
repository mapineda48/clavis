{
  "id": "__KEYCLOAK_REALM__",
  "realm": "__KEYCLOAK_REALM__",
  "displayName": "Clavis",
  "displayNameHtml": "<b>Clavis</b>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": false,
  "loginTheme": "__KEYCLOAK_LOGIN_THEME__",
  "emailTheme": "__KEYCLOAK_EMAIL_THEME__",
  "smtpServer": {
    "host": "__KEYCLOAK_SMTP_HOST__",
    "port": "__KEYCLOAK_SMTP_PORT__",
    "from": "__KEYCLOAK_SMTP_FROM__",
    "fromDisplayName": "__KEYCLOAK_SMTP_FROM_DISPLAY_NAME__",
    "replyTo": "__KEYCLOAK_SMTP_FROM__",
    "ssl": "__KEYCLOAK_SMTP_SSL__",
    "starttls": "__KEYCLOAK_SMTP_STARTTLS__",
    "auth": "__KEYCLOAK_SMTP_AUTH__",
    "user": "__KEYCLOAK_SMTP_USER__",
    "password": "__KEYCLOAK_SMTP_PASSWORD__"
  },
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "es"
  ],
  "defaultLocale": "en",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "actionTokenGeneratedByUserLifespan": 1800,
  "defaultRole": {
    "name": "default-roles-__KEYCLOAK_REALM__",
    "description": "Realm default role: own account, offline access and the basic Clavis permissions",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "default-roles-__KEYCLOAK_REALM__",
        "description": "Realm default role: own account, offline access and the basic Clavis permissions",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "clavis-user"
          ],
          "client": {
            "account": [
              "manage-account",
              "view-profile"
            ]
          }
        }
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "clavis-user",
        "description": "Basic user: reads and creates their own tasks",
        "composite": true,
        "clientRole": false,
        "composites": {
          "client": {
            "__KEYCLOAK_API_CLIENT_ID__": [
              "todos:read",
              "todos:write"
            ]
          }
        }
      },
      {
        "name": "clavis-manager",
        "description": "Team lead: sees every task, deletes them and lists users",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "clavis-user"
          ],
          "client": {
            "__KEYCLOAK_API_CLIENT_ID__": [
              "todos:read:all",
              "todos:delete",
              "users:read"
            ]
          }
        }
      },
      {
        "name": "clavis-admin",
        "description": "Full administration: everything a team lead can do, plus management and auditing",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "clavis-manager"
          ],
          "client": {
            "__KEYCLOAK_API_CLIENT_ID__": [
              "admin:manage"
            ]
          }
        }
      }
    ],
    "client": {
      "__KEYCLOAK_API_CLIENT_ID__": [
        {
          "name": "todos:read",
          "description": "Read own or assigned tasks",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "todos:read:all",
          "description": "Read the tasks of every user",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "todos:write",
          "description": "Create and update tasks",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "todos:delete",
          "description": "Delete tasks and attachments",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "users:read",
          "description": "List the users",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "admin:manage",
          "description": "Access statistics, auditing and administration features",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "__KEYCLOAK_APP_CLIENT_ID__",
      "name": "Clavis SPA",
      "description": "Public frontend client (React + Vite) with PKCE S256",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "__APP_DEV_URL__",
      "baseUrl": "__APP_DEV_URL__",
      "adminUrl": "__APP_DEV_URL__",
      "redirectUris": [
        "__APP_DEV_URL__/*",
        "__APP_PROD_URL__/*"
      ],
      "webOrigins": [
        "__APP_DEV_URL__",
        "__APP_PROD_URL__",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-clavis-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "__KEYCLOAK_API_CLIENT_ID__",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "__KEYCLOAK_API_CLIENT_ID__",
      "name": "Clavis API",
      "description": "Confidential client that represents the API and holds the permissions as client roles",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__KEYCLOAK_API_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "id": "a0000000-0000-4000-a000-000000000001",
      "username": "__DEMO_ADMIN_USERNAME__",
      "email": "__DEMO_ADMIN_EMAIL__",
      "firstName": "Administrator",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__DEMO_ADMIN_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-__KEYCLOAK_REALM__",
        "clavis-admin"
      ]
    },
    {
      "id": "a0000000-0000-4000-a000-000000000002",
      "username": "__DEMO_MANAGER_USERNAME__",
      "email": "__DEMO_MANAGER_EMAIL__",
      "firstName": "Manager",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__DEMO_MANAGER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-__KEYCLOAK_REALM__",
        "clavis-manager"
      ]
    },
    {
      "id": "a0000000-0000-4000-a000-000000000003",
      "username": "__DEMO_USER_USERNAME__",
      "email": "__DEMO_USER_EMAIL__",
      "firstName": "Worker",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__DEMO_USER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-__KEYCLOAK_REALM__",
        "clavis-user"
      ]
    }
  ]
}
