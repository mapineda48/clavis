# Generated by Terraform. Do not edit on the host: the next apply overwrites it.
#
# Two things here are not obvious and cost a day each if you get them wrong:
#
#   * `libfuse.mount-options` is NOT a recognised key. It parses without error
#     and does absolutely nothing, so a uid/gid/umask written there is silently
#     ignored. The real keys are scalars: libfuse.uid, libfuse.gid.
#
#   * declaring a non-empty `components:` list REPLACES the default pipeline, so
#     omitting file_cache and attr_cache means every read and write becomes its
#     own REST round trip. They are listed explicitly for that reason.
#
# Nothing that needs POSIX semantics may live on this mount: no database, no
# append-only file, nothing that relies on locking or on an atomic rename. It
# holds the deploy bundle and a copy of the ACME state, both of which are
# written whole, once.

version: 2

logging:
  type: syslog
  level: LOG_WARNING

components:
  - libfuse
  - file_cache
  - attr_cache
  - azstorage

libfuse:
  attribute-expiration-sec: 120
  entry-expiration-sec: 120
  negative-entry-expiration-sec: 20
  # Containers read the bundle, so other users must be able to traverse it.
  # Careful: this forces every entry to report 0777 and overrides
  # `default-permission` outright. It is the reason Traefik's acme.json is kept
  # on local disk instead of here — Traefik refuses any ACME store with group or
  # other permission bits set, and chmod on a flat-namespace container returns
  # success without doing anything at all.
  allow-other: true

file_cache:
  path: /var/cache/blobfuse2
  timeout-sec: 60
  allow-non-empty-temp: true
  cleanup-on-start: true

attr_cache:
  timeout-sec: 120

azstorage:
  type: block
  account-name: ${account_name}
  endpoint: https://${account_name}.blob.core.windows.net
  mode: sas
  sas: "${sas_token}"
  container: ${container}
