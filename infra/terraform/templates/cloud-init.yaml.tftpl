#cloud-config
# Generated by Terraform from infra/terraform/templates/cloud-init.yaml.tftpl.
#
# Every file is delivered base64-encoded so that YAML indentation can never
# corrupt a script or a systemd unit. The real sources live under
# infra/deploy/ and are readable, lintable files in the repository.
#
# What is deliberately NOT here: application secrets. The only credential in
# user-data is a SAS scoped to a single blob container. DigitalOcean serves
# user-data unauthenticated on the metadata endpoint for the droplet's whole
# life and it cannot be cleared, so everything else is fetched from the private
# blob container at boot instead.

package_update: true
package_upgrade: false

packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - fail2ban
  - fuse3
  - gnupg
  - jq
  - unattended-upgrades

write_files:
%{ for f in files ~}
  - path: ${f.path}
    permissions: "${f.mode}"
    encoding: b64
    content: ${f.b64}
%{ endfor ~}

runcmd:
  # cloud-init concatenates these into ONE script and runs it with /bin/sh,
  # which on Ubuntu is dash. `pipefail` is a bashism: dash aborts the whole
  # script on the `set` line itself, so every command below silently never runs
  # and the only symptom is `cloud-init status: error`.
  - set -eux
  - install -d -m 0755 /opt/clavis /opt/clavis/stack /var/lib/clavis /etc/clavis
  - install -d -m 0700 /var/lib/traefik
  - install -d -m 0755 /mnt/deploy /var/cache/blobfuse2

  # --- host baseline --------------------------------------------------------
  - sysctl --system
  - sshd -t && systemctl daemon-reload
  - systemctl enable --now fail2ban || true

  # --- blobfuse2 ------------------------------------------------------------
  # Pinned. If the pin is unavailable the newest is installed instead and the
  # fact is recorded, because a droplet that refuses to boot is worse than a
  # droplet whose exact patch level is written down and reported.
  - curl -fsSL -o /tmp/ms-prod.deb https://packages.microsoft.com/config/ubuntu/24.04/packages-microsoft-prod.deb
  - dpkg -i /tmp/ms-prod.deb
  - apt-get update
  - apt-get install -y blobfuse2=2.5.4 || apt-get install -y blobfuse2
  - blobfuse2 version | tee /etc/clavis/versions

  # --- docker ---------------------------------------------------------------
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - docker --version | tee -a /etc/clavis/versions
  - docker compose version | tee -a /etc/clavis/versions

  # --- mount, then restore the certificates, then let docker start ----------
  # The drop-in in /etc/systemd/system/docker.service.d makes docker.service
  # require both units, so this ordering is enforced by systemd and not merely
  # by the order of the lines below.
  - systemctl daemon-reload
  - systemctl enable --now clavis-blobfuse2.service
  - systemctl enable --now clavis-acme-restore.service
  - systemctl restart docker

  # --- stop containers reaching the metadata service ------------------------
  # Must run after dockerd, because the DOCKER-USER chain does not exist until
  # then. A rule in FORWARD or in ufw would be silently bypassed.
  - systemctl enable --now clavis-metadata-guard.service

  # --- converge on the published desired state ------------------------------
  - systemctl enable clavis-acme-backup.path clavis-acme-backup.timer clavis-deploy.timer
  - systemctl start clavis-acme-backup.path clavis-acme-backup.timer clavis-deploy.timer
  - systemctl start clavis-deploy.service || true

final_message: "clavis host ready after $UPTIME seconds"
