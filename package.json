{
  "name": "clavis",
  "version": "0.1.0",
  "private": true,
  "description": "Clavis demo with Keycloak, Fastify, React and Docker Compose",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @clavis/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "verify": "bash scripts/verify-api.sh && bash scripts/verify-login-theme.sh",
    "verify:api": "bash scripts/verify-api.sh",
    "verify:theme": "bash scripts/verify-login-theme.sh",
    "verify:reset": "bash scripts/verify-password-reset.sh",
    "up": "docker compose up -d --build",
    "up:full": "docker compose --profile full up -d --build",
    "down": "docker compose down",
    "reset": "docker compose down -v",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "keycloak:render": "node infra/keycloak/render-realm.mjs"
  }
}
