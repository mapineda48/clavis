{
  "name": "@clavis/api",
  "version": "1.0.0",
  "private": true,
  "description": "Clavis API: Express + PostgreSQL + Valkey + Azure Blob + Keycloak",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@azure/storage-blob": "12.33.0",
    "@clavis/shared": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "jose": "6.2.6",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "resend": "6.18.1",
    "swagger-ui-dist": "5.32.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.2",
    "@types/swagger-ui-dist": "3.30.6",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
