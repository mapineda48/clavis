{
  "name": "@erp/api",
  "version": "1.0.0",
  "private": true,
  "description": "API del ERP demo: Fastify + PostgreSQL + Valkey + Azure Blob + Keycloak",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/storage-blob": "12.33.0",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.11.0",
    "fastify-plugin": "6.0.0",
    "ioredis": "5.11.1",
    "jose": "6.2.6",
    "pg": "8.22.0",
    "resend": "6.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
