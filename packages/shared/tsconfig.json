{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Consumed by NodeNext (api) and bundler (app) resolvers alike, so the
       package compiles to plain ESM with declarations and lets the `exports`
       map in package.json do the resolution. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
