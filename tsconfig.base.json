{
  // Compiler options shared by every package in the workspace.
  // Each package extends this file and adds its own: "module"/"moduleResolution"
  // (the API uses NodeNext, the app uses bundler), "rootDir", "outDir", "jsx",
  // "include", etc. Neither "include" nor "files" is declared here on purpose:
  // this tsconfig compiles nothing.
  "compilerOptions": {
    // Node 22 and modern browsers support ES2023, so there is no need to transpile further.
    "target": "ES2023",
    "useDefineForClassFields": true,

    // --- type strictness
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Left at false on purpose: with true, `{ foo?: string }` stops accepting
    // `{ foo: undefined }` and building option objects becomes constant friction.
    "exactOptionalPropertyTypes": false,

    // --- interoperability and ergonomics
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // --- output
    "sourceMap": true,
    "newLine": "lf"
  }
}
